. * helper: turn a block of (item, v_stata, v_py, tol) into verdicts and save it
. capture program drop fin_block

. program define fin_block
  1.     args bname
  2.     gen str12 block = "`bname'"
  3.     gen double diff = abs(v_stata - v_py)
  4.     gen str8 verdict = cond(missing(diff), "FAIL", cond(diff <= tol, "PASS", "FAIL"))
  5.     keep block item v_stata v_py diff tol verdict
  6.     save "$OUT/_blk_`bname'.dta", replace
  7.     quietly count if verdict == "FAIL"
  8.     di as text "Block `bname': " _N " checks, " r(N) " FAIL"
  9. end

