. use "$OUT/stata_results_long.dta", clear

. generate pykey = cond(mid == 3, 2, mid)

. generate str16 pyvar = cond(variable == "growth_w197", "growth_w", variable)

. merge m:1 pykey pyvar using "`pyall'", keep(master match) gen(_mp)

    Result                           # of obs.
