. *------------------------------------------------------------------------------
. * PROGRAMS
. *------------------------------------------------------------------------------
. capture program drop chkcount

. program define chkcount
  1.     version 14.1
  2.     args blk item got want note
  3.     local bad = abs(`got' - `want')
  4.     local verdict = cond(`bad' == 0, "PASS", "FAIL")
  5.     post pf ("`blk'") ("`item'") (`got') (`want') (`bad') ("`verdict'") ("`note'")
  6.     di as text %-6s "`verdict'" " [`blk'] `item': got `got', expected `want'"
  7. end

. 
. capture program drop chkinfo

. program define chkinfo
  1.     version 14.1
  2.     args blk item val note
  3.     post pf ("`blk'") ("`item'") (`val') (.) (.) ("INFO") ("`note'")
  4.     di as text %-6s "INFO" " [`blk'] `item': `val'  `note'"
  5. end

. 
. tempfile rep pyall res ind

. postfile pf str3 block str100 item double value double reference double n_bad str5 verdict str240 note using "`rep'", replace
