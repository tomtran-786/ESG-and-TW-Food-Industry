. rename firm firm_label          // raw text label in the CSV (e.g. 1201-name); frees the name firm for the numeric id

. encode stock_code, gen(firm)

. sort firm year

. isid firm year

. xtset firm year
       panel variable:  firm (unbalanced)
        time variable:  year, 2015 to 2025
                delta:  1 unit

