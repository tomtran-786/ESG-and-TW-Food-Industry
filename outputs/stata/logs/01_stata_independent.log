. *------------------------------------------------------------------------------
. * 0. PACKAGES: none. The wild cluster bootstrap is coded in Mata (section 1, wcb), so no SSC package is needed.
. *------------------------------------------------------------------------------
. 
. *------------------------------------------------------------------------------
. * 1. MATA HELPERS
. *   q7():   quantile, type 7 (h = (n-1)p + 1, linear interpolation), as R's default
. *   cr0v(): cluster-robust sandwich with NO small-sample factor (CR0), computed from the
. *           regressors partialled out of the firm and year dummies and the regression residuals.
. *           Used to separate the sandwich itself from the small-sample convention.
. *------------------------------------------------------------------------------
. mata:
------------------------------------------------- mata (type end to exit) --------------------------------------------------------------------------------------
: real scalar q7(real colvector x, real scalar p)
> {
>     real colvector s
>     real scalar n, h, lo
>     s  = sort(select(x, x :< .), 1)
>     n  = rows(s)
>     h  = (n - 1) * p + 1
>     lo = floor(h)
>     if (lo >= n) return(s[n])
>     return(s[lo] + (h - lo) * (s[lo + 1] - s[lo]))
> }

: 
: real matrix cr0v(string scalar xvars, string scalar uvar, string scalar cvar, string scalar touse)
> {
>     real matrix X, XXi, meat, V, Xg, info
>     real colvector u, id, ug, sc
>     real scalar g, G
>     X    = st_data(., tokens(xvars), touse)
>     u    = st_data(., uvar, touse)
>     id   = st_data(., cvar, touse)
>     info = panelsetup(id, 1)
>     G    = rows(info)
>     XXi  = invsym(cross(X, X))
>     meat = J(cols(X), cols(X), 0)
>     for (g = 1; g <= G; g++) {
>         Xg   = panelsubmatrix(X, g, info)
>         ug   = panelsubmatrix(u, g, info)
>         sc   = cross(Xg, ug)
>         meat = meat + sc * sc'
>     }
>     V = XXi * meat * XXi
>     return(V)
> }

: 
: // wcb(): restricted wild cluster bootstrap-t for ONE coefficient (column j of xvars) of the LSDV regression
: //        y = [xvars, firm dummies, year dummies, constant] g + u.  Null beta_j = 0 imposed, Rademacher weights drawn
: //        per cluster, B draws, CR0 cluster covariance in the original and in every bootstrap sample
: //        (a common small-sample scalar cancels in |t*| >= |t|, so the p-value does not depend on it).
: //        Frisch-Waugh form:  t* = x~' (e_r * w) / sqrt( sum_g ( x~_g' u*_g )^2 ),  u* = M_Z (e_r * w),
: //        e_r = residuals of y on all columns except j, x~ = x_j residualised on the same columns.
: //        Returns (p-value, original t, beta_j); the caller checks t and beta_j against regress.
: real rowvector wcb(string scalar yvar, string scalar xvars, string scalar dvars, string scalar cvar, string scalar touse, real scalar j, real scalar B, real s
> calar seed)
> {
>     real matrix X, D, Z, Zm, Rm, Zi, E, U, S, Wg, info
>     real colvector y, id, er, xt, xj, idx, U0
>     real rowvector keep, num, ss
>     real scalar N, G, g, ss0, t0, bj, p
> 
>     y    = st_data(., yvar, touse)
>     X    = st_data(., tokens(xvars), touse)
>     D    = st_data(., tokens(dvars), touse)
>     id   = st_data(., cvar, touse)
>     N    = rows(y)
>     Z    = X, D, J(N, 1, 1)
>     keep = select(1..cols(Z), (1..cols(Z)) :!= j)
>     Zm   = Z[., keep]
>     xj   = Z[., j]
>     Rm   = invsym(cross(Zm, Zm))
>     er   = y  - Zm * (Rm * cross(Zm, y))
>     xt   = xj - Zm * (Rm * cross(Zm, xj))
>     Zi   = invsym(cross(Z, Z))
>     info = panelsetup(id, 1)
>     G    = rows(info)
> 
>     U0  = y - Z * (Zi * cross(Z, y))
>     ss0 = 0
>     for (g = 1; g <= G; g++) {
>         ss0 = ss0 + sum(panelsubmatrix(xt, g, info) :* panelsubmatrix(U0, g, info))^2
>     }
>     t0 = sum(xt :* y) / sqrt(ss0)
>     bj = sum(xt :* y) / sum(xt :* xt)
> 
>     rseed(seed)
>     Wg  = 2 * (runiform(G, B) :> 0.5) :- 1
>     idx = J(N, 1, 1)
>     for (g = 1; g <= G; g++) {
>         idx[|info[g, 1], 1 \ info[g, 2], 1|] = J(info[g, 2] - info[g, 1] + 1, 1, g)
>     }
>     E   = er :* Wg[idx, .]
>     num = cross(xt, E)
>     U   = E - Z * (Zi * cross(Z, E))
>     S   = xt :* U
>     ss  = J(1, B, 0)
>     for (g = 1; g <= G; g++) {
>         ss = ss + colsum(panelsubmatrix(S, g, info)) :^ 2
>     }
>     p = sum(abs(num :/ sqrt(ss)) :>= abs(t0) * (1 - 1e-10)) / B
>     return((p, t0, bj))
> }

: end
----------------------------------------------------------------------------------------------------------------------------------------------------------------

. 
. *------------------------------------------------------------------------------
. * 2. STATA PROGRAMS
. *------------------------------------------------------------------------------
. * 2a. winsor7: winsorize varname at p1/p99 of the rows where samp==1 (type 7), keep original
. capture program drop winsor7

. program define winsor7
  1.     syntax varname, GENerate(name) SAMP(varname)
  2.     local v `varlist'
  3.     mata: st_numscalar("__lo", q7(st_data(., "`v'", "`samp'"), 0.01))
  4.     mata: st_numscalar("__hi", q7(st_data(., "`v'", "`samp'"), 0.99))
  5.     quietly gen double `generate' = `v'
  6.     quietly replace `generate' = scalar(__lo) if `v' < scalar(__lo) & !missing(`v')
  7.     quietly replace `generate' = scalar(__hi) if `v' > scalar(__hi) & !missing(`v')
  8.     quietly count if `samp' == 1 & `v' < scalar(__lo) & !missing(`v')
  9.     local nlo = r(N)
 10.     quietly count if `samp' == 1 & `v' > scalar(__hi) & !missing(`v')
 11.     local nhi = r(N)
 12.     quietly count if `samp' == 1 & !missing(`v')
 13.     local nn = r(N)
 14.     post cuts ("`v'") ("`generate'") (scalar(__lo)) (scalar(__hi)) (`nn') (`nlo') (`nhi')
 15.     di as text %-16s "`generate'" "  p01 = " %12.6f scalar(__lo) "  p99 = " %12.6f scalar(__hi) "   clipped low/high in sample: `nlo' / `nhi'"
 16. end

. 
. * 2b. do_twfe: one two-way FE model (firm and year dummies = least-squares dummy variables, LSDV),
. *     all inference variants, one row per coefficient.
. *     args: mid  label  depvar  regressors(first = financial-constraint variable)  sample-condition  bootall
. *     The LSDV slopes equal the within estimator; singleton firms stay in the sample (D19).
. capture program drop do_twfe

. program define do_twfe
  1.     args mid mlabel yv xl scnd bootall
  2. 
.     capture drop _u _tu _es _nf _tag _yy
  3.     capture drop _xr*
  4.     capture drop _fd* _yd*
  5.     local k : word count `xl'
  6.     gen byte _tu = (`scnd')
  7.     global mlab`mid' "`mlabel'"
  8. 
.     * (i) conventional (non-robust) covariance
.     quietly regress `yv' `xl' i.firm i.year if _tu
  9.     matrix Vn = e(V)
 10.     local dfr = e(df_r)
 11. 
.     * (ii) total within sum of squares = residual SS of y on the dummies alone (for within R2)
.     quietly regress `yv' i.firm i.year if _tu
 12.     local rss0 = e(rss)
 13. 
.     * (iii) regressors partialled out of the firm and year dummies (for the CR0 sandwich)
.     local xr ""
 14.     local i = 0
 15.     foreach x of local xl {
 16.         local ++i
 17.         quietly regress `x' i.firm i.year if _tu
 18.         quietly predict double _xr`i' if e(sample), residuals
 19.         local xr "`xr' _xr`i'"
 20.     }
 21. 
.     * (iv) main estimate, Stata firm-clustered SE: CR1 = G/(G-1) x (N-1)/(N-K), K = all estimated parameters
.     quietly regress `yv' `xl' i.firm i.year if _tu, vce(cluster firm)
 22.     matrix b  = e(b)
 23.     matrix Vr = e(V)
 24.     local N = e(N)
 25.     local Krank = `N' - `dfr'     // number of estimated parameters K = N - df_r of the non-robust fit (e(rank) is the rank of V, not K)
 26.     scalar r2w = 1 - e(rss) / `rss0'
 27.     quietly predict double _u if e(sample), residuals
 28.     gen byte _es = e(sample)
 29.     egen _nf  = total(_es), by(firm)
 30.     egen _tag = tag(firm) if _es
 31.     egen _yy  = tag(year) if _es
 32.     quietly count if _tag == 1
 33.     local G24 = r(N)
 34.     quietly count if _tag == 1 & _nf >= 2
 35.     local G22 = r(N)
 36.     quietly count if _yy == 1
 37.     local Ny = r(N)
 38. 
.     * (v) CR0 sandwich (no small-sample factor) from the partialled regressors and residuals
.     mata: st_matrix("V0", cr0v("`xr'", "_u", "firm", "_tu"))
 39. 
.     * (vi) wild cluster bootstrap (restricted, Rademacher) coded in Mata, on this LSDV regression.
.     *      Mata design = regressors + firm dummies + year dummies (first level of each dropped) + constant,
.     *      i.e. the same column space as regress in (iv), so its column count must equal K = N - df_r.
.     quietly tab firm if _es, gen(_fd)
 40.     local nfd = r(r)
 41.     quietly tab year if _es, gen(_yd)
 42.     local nyd = r(r)
 43.     local dl ""
 44.     forvalues i = 2/`nfd' {
 45.         local dl "`dl' _fd`i'"
 46.     }
 47.     forvalues i = 2/`nyd' {
 48.         local dl "`dl' _yd`i'"
 49.     }
 50.     local Kdes = `k' + `nfd' + `nyd' - 1
 51.     if `Krank' != `Kdes' {
 52.         di as error "Design mismatch in model `mid': regress estimated `Krank' parameters, bootstrap design has `Kdes'"
 53.         exit 459
 54.     }
 55.     local nb = cond(`bootall', `k', 1)
 56.     forvalues j = 1/`nb' {
 57.         local x : word `j' of `xl'
 58.         mata: st_matrix("WB", wcb("`yv'", "`xl'", "`dl'", "firm", "_es", `j', $BOOT_REPS, $BOOT_SEED))
 59.         scalar chk = max(abs(WB[1, 2] - b[1, `j'] / sqrt(V0[`j', `j'])), abs(WB[1, 3] - b[1, `j']))
 60.         if scalar(chk) > 1e-5 {
 61.             di as error "WARNING model `mid', `x': Mata t or beta differs from regress by " scalar(chk) "; wild p-value set to missing"
 62.             scalar pw`j' = .
 63.         }
 64.         else {
 65.             scalar pw`j' = WB[1, 1]
 66.         }
 67.     }
 68.     forvalues j = `=`nb' + 1'/`k' {
 69.         scalar pw`j' = .
 70.     }
 71. 
.     * (vii) post one row per coefficient (results) and formatted cells (tables)
.     local vorder "sa fc_dummy sa_lag size_ln_w roa_w lev_w tq_w growth_w growth_w197 cash_w"
 72.     local j = 0
 73.     foreach x of local xl {
 74.         local ++j
 75.         scalar bj  = b[1, `j']
 76.         scalar sej = sqrt(Vr[`j', `j'])
 77.         scalar pj  = 2 * ttail(`G22' - 1, abs(bj / sej))
 78.         local star = cond(pj < 0.01, "***", cond(pj < 0.05, "**", cond(pj < 0.1, "*", "")))
 79.         post res (`mid') ("`mlabel'") ("`yv'") ("`x'") (scalar(bj)) (sqrt(Vn[`j', `j'])) (sqrt(V0[`j', `j'])) (scalar(sej)) (scalar(pw`j')) (`N') (`k') (`G
> 22') (`G24') (`Ny') (scalar(r2w)) (`dfr')
 80.         local o : list posof "`x'" in vorder
 81.         local lab "`x'"
 82.         if "`x'" == "sa"          local lab "SA Index"
 83.         if "`x'" == "fc_dummy"    local lab "SA dummy (above sample median)"
 84.         if "`x'" == "sa_lag"      local lab "SA Index (t-1)"
 85.         if "`x'" == "size_ln_w"   local lab "SIZE (ln total assets)"
 86.         if "`x'" == "roa_w"       local lab "ROA"
 87.         if "`x'" == "lev_w"       local lab "LEV"
 88.         if "`x'" == "tq_w"        local lab "TQ"
 89.         if "`x'" == "growth_w"    local lab "GROWTH"
 90.         if "`x'" == "growth_w197" local lab "GROWTH (winsorized on 197 rows)"
 91.         if "`x'" == "cash_w"      local lab "CASH"
 92.         local cb  = string(scalar(bj), "%9.4f") + "`star'"
 93.         local cse = "(" + string(scalar(sej), "%9.4f") + ")"
 94.         local ob  = 10 * `o'
 95.         local ose = 10 * `o' + 1
 96.         post cells (`mid') (`ob')  ("`lab'") ("`cb'")
 97.         post cells (`mid') (`ose') ("") ("`cse'")
 98.     }
 99.     post cells (`mid') (9001) ("Observations") (string(`N', "%9.0f"))
100.     post cells (`mid') (9002) ("Firms (with >= 2 obs.)") ("`G24' (`G22')")
101.     post cells (`mid') (9003) ("Within R2") (string(scalar(r2w), "%9.3f"))
102.     post cells (`mid') (9004) ("FC variable: p-value, t(G-1)") (string(2 * ttail(`G22' - 1, abs(b[1, 1] / sqrt(Vr[1, 1]))), "%9.3f"))
103.     post cells (`mid') (9005) ("FC variable: p-value, wild cluster bootstrap") (string(scalar(pw1), "%9.3f"))
104. 
.     di as text "model `mid' [`mlabel']: N = `N', firms = `G24' (`G22' with >= 2 obs), years = `Ny', first coefficient = " %9.4f b[1, 1]
105.     capture drop _u _tu _es _nf _tag _yy
106.     capture drop _xr*
107.     capture drop _fd* _yd*
108.     sort firm year
109. end

. 
. * 2c. do_re: random firm effects + year dummies (A13), same arguments as do_twfe without bootall.
. *     Posts one row per coefficient to the open postfile resre and formatted cells to cells.
. capture program drop do_re

. program define do_re
  1.     args mid mlabel yv xl scnd
  2. 
.     capture drop _tu _es _nf _tag _yy
  3.     local k : word count `xl'
  4.     gen byte _tu = (`scnd')
  5.     global mlab`mid' "`mlabel'"
  6. 
.     * (i) conventional covariance (no clustering)
.     quietly xtreg `yv' `xl' i.year if _tu, re
  7.     matrix Vn = e(V)
  8. 
.     * (ii) main estimate: firm-clustered covariance, Stata's xtreg convention
.     quietly xtreg `yv' `xl' i.year if _tu, re vce(cluster firm)
  9.     matrix b  = e(b)
 10.     matrix Vr = e(V)
 11.     local N  = e(N)
 12.     local Gc = e(N_clust)
 13.     scalar r2w = e(r2_w)
 14.     scalar r2o = e(r2_o)
 15.     gen byte _es = e(sample)
 16.     egen _nf  = total(_es), by(firm)
 17.     egen _tag = tag(firm) if _es
 18.     egen _yy  = tag(year) if _es
 19.     quietly count if _tag == 1
 20.     local G24 = r(N)
 21.     quietly count if _tag == 1 & _nf >= 2
 22.     local G22 = r(N)
 23.     quietly count if _yy == 1
 24.     local Ny = r(N)
 25.     local dfnk = `N' - (`k' + `Ny')     // K = slopes + constant + (Ny - 1) year dummies
 26.     if `Gc' != `G24' {
 27.         di as error "Model `mid': e(N_clust) = `Gc' but the sample has `G24' firms"
 28.         exit 459
 29.     }
 30. 
.     local vorder "sa fc_dummy sa_lag size_ln_w roa_w lev_w tq_w growth_w growth_w197 cash_w"
 31.     local j = 0
 32.     foreach x of local xl {
 33.         local ++j
 34.         scalar bj  = b[1, `j']
 35.         scalar sej = sqrt(Vr[`j', `j'])
 36.         scalar tj  = bj / sej
 37.         scalar pz  = 2 * normal(-abs(tj))
 38.         scalar pg  = 2 * ttail(`G24' - 1, abs(tj))
 39.         scalar pnk = 2 * ttail(`dfnk', abs(tj))
 40.         local star = cond(scalar(pg) < 0.01, "***", cond(scalar(pg) < 0.05, "**", cond(scalar(pg) < 0.1, "*", "")))
 41.         post resre (`mid') ("`mlabel'") ("`yv'") ("`x'") (scalar(bj)) (sqrt(Vn[`j', `j'])) (scalar(sej)) (scalar(pz)) (scalar(pg)) (scalar(pnk)) (`N') (`k'
> ) (`G24') (`G22') (`Ny') (`dfnk') (scalar(r2w)) (scalar(r2o))
 42.         local o : list posof "`x'" in vorder
 43.         local lab "`x'"
 44.         if "`x'" == "sa"          local lab "SA Index"
 45.         if "`x'" == "fc_dummy"    local lab "SA dummy (above sample median)"
 46.         if "`x'" == "sa_lag"      local lab "SA Index (t-1)"
 47.         if "`x'" == "size_ln_w"   local lab "SIZE (ln total assets)"
 48.         if "`x'" == "roa_w"       local lab "ROA"
 49.         if "`x'" == "lev_w"       local lab "LEV"
 50.         if "`x'" == "tq_w"        local lab "TQ"
 51.         if "`x'" == "growth_w"    local lab "GROWTH"
 52.         if "`x'" == "growth_w197" local lab "GROWTH (winsorized on 197 rows)"
 53.         if "`x'" == "cash_w"      local lab "CASH"
 54.         post cells (`mid') (10 * `o')     ("`lab'") (string(scalar(bj), "%9.4f") + "`star'")
 55.         post cells (`mid') (10 * `o' + 1) ("")      ("(" + string(scalar(sej), "%9.4f") + ")")
 56.     }
 57.     post cells (`mid') (9001) ("Observations") (string(`N', "%9.0f"))
 58.     post cells (`mid') (9002) ("Firms (with >= 2 obs.)") ("`G24' (`G22')")
 59.     post cells (`mid') (9003) ("Within R2") (string(scalar(r2w), "%9.3f"))
 60.     post cells (`mid') (9006) ("Overall R2 (RE)") (string(scalar(r2o), "%9.3f"))
 61.     post cells (`mid') (9007) ("FC variable: p-value, t(G-1), G = all firms (RE)") (string(2 * ttail(`G24' - 1, abs(b[1, 1] / sqrt(Vr[1, 1]))), "%9.4f"))
 62.     post cells (`mid') (9008) ("FC variable: p-value, z (Stata xtreg, re output)") (string(2 * normal(-abs(b[1, 1] / sqrt(Vr[1, 1]))), "%9.4f"))
 63. 
.     di as text "RE model `mid' [`mlabel']: N = `N', clusters = `G24', first coefficient = " %9.4f b[1, 1] "  SE = " %9.4f sqrt(Vr[1, 1])
 64.     capture drop _tu _es _nf _tag _yy
 65.     sort firm year
 66. end

. 
. * 2d. export_table: wide table (coefficient and SE rows, models in columns) to .xlsx
. capture program drop export_table

. program define export_table
  1.     args fname idlist
  2.     preserve
  3.     use "$OUT/stata_cells.dta", clear
  4.     gen byte keepme = 0
  5.     foreach i of local idlist {
  6.         replace keepme = 1 if mid == `i'
  7.     }
  8.     keep if keepme == 1
  9.     drop keepme
 10.     reshape wide cell, i(ord lbl) j(mid)
 11.     sort ord
 12.     drop ord
 13.     label variable lbl "Dependent variable / regressor"
 14.     foreach i of local idlist {
 15.         label variable cell`i' "${mlab`i'}"
 16.     }
 17.     export excel using "$OUT/`fname'.xlsx", firstrow(varlabels) replace
 18.     restore
 19. end

