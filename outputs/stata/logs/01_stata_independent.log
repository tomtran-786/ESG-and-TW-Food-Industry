. *------------------------------------------------------------------------------
. * 3. LOAD THE MASTER PANEL (A1)
. *------------------------------------------------------------------------------
. import delimited using "$ROOT/data_clean/panel_merged.csv", clear varnames(1) stringcols(1) encoding("utf-8")
(54 vars, 250 obs)

. 
. local need stock_code year market_ifrs equity total_assets total_liabilities cash_amt revenue net_income_consol mcap_m usd_ntd founding_year tesg e s g in_sam
> ple

. foreach v of local need {
  2.     capture confirm variable `v'
  3.     if _rc {
  4.         di as error "Variable `v' is missing from panel_merged.csv"
  5.         exit 111
  6.     }
  7. }

. foreach v in year equity total_assets total_liabilities cash_amt revenue net_income_consol mcap_m usd_ntd founding_year tesg e s g {
  2.     capture confirm numeric variable `v'
  3.     if _rc {
  4.         di as error "`v' was not imported as numeric. Open the CSV and check for text in that column."
  5.         exit 109
  6.     }
  7.     recast double `v'
  8. }

. rename (e s g) (tesg_e tesg_s tesg_g)

