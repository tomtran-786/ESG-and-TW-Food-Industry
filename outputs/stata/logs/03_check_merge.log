. *------------------------------------------------------------------------------
. * PROGRAMS
. *------------------------------------------------------------------------------
. * hdrfind: name of the variable whose row-1 text (trimmed) equals the target header
. capture program drop hdrfind

. program define hdrfind, rclass
  1.     version 14.1
  2.     args target
  3.     local hit ""
  4.     local nhit 0
  5.     foreach v of varlist _all {
  6.         local h = ustrtrim(`v'[1])
  7.         if `"`h'"' == `"`target'"' {
  8.             local hit "`v'"
  9.             local ++nhit
 10.         }
 11.     }
 12.     if `nhit' != 1 {
 13.         di as error `"Header [`target'] found `nhit' times in row 1 (expected exactly once)"'
 14.         exit 459
 15.     }
 16.     return local v "`hit'"
 17. end

. 
. * rawpick: rename the column whose header is hdr to newname
. capture program drop rawpick

. program define rawpick
  1.     version 14.1
  2.     args hdr newname
  3.     hdrfind `"`hdr'"'
  4.     local v "`r(v)'"
  5.     rename `v' `newname'
  6. end

. 
. * tonum: string variable -> double. Empty and "-" become missing. Any other non-numeric text stops the run.
. capture program drop tonum

. program define tonum
  1.     version 14.1
  2.     args v
  3.     quietly {
  4.         replace `v' = ustrtrim(`v')
  5.         replace `v' = "" if `v' == "-"
  6.         generate double `v'__n = real(`v')
  7.         count if missing(`v'__n) & `v' != ""
  8.         local bad = r(N)
  9.     }
 10.     if `bad' > 0 {
 11.         di as error "tonum: `v' has `bad' cells that are neither empty, a dash nor a number"
 12.         list `v' if missing(`v'__n) & `v' != "", noobs
 13.         exit 459
 14.     }
 15.     drop `v'
 16.     rename `v'__n `v'
 17. end

. 
. * normstr: trim a string variable and read "-" as empty
. capture program drop normstr

. program define normstr
  1.     version 14.1
  2.     args v
  3.     quietly replace `v' = ustrtrim(`v')
  4.     quietly replace `v' = "" if `v' == "-"
  5. end

. 
. * chkcount: a count that docs/data_log.md reports, against the rebuilt count
. capture program drop chkcount

. program define chkcount
  1.     version 14.1
  2.     args blk item got want note
  3.     local bad = abs(`got' - `want')
  4.     local verdict = cond(`bad' == 0, "PASS", "FAIL")
  5.     post pf ("`blk'") ("`item'") (`got') (`want') (`bad') (.) ("`verdict'") ("`note'")
  6.     di as text %-6s "`verdict'" " [`blk'] `item': rebuilt `got', reference `want'"
  7. end

. 
. * chkinfo: a number reported for the reader, no verdict
. capture program drop chkinfo

. program define chkinfo
  1.     version 14.1
  2.     args blk item val note
  3.     post pf ("`blk'") ("`item'") (`val') (.) (.) (.) ("INFO") ("`note'")
  4.     di as text %-6s "INFO" " [`blk'] `item': `val'  `note'"
  5. end

. 
. * cmp_num: rebuilt variable v against panel variable p_v (both numeric), rows present in both files
. capture program drop cmp_num

. program define cmp_num
  1.     version 14.1
  2.     args v
  3.     quietly {
  4.         count if _mm == 3
  5.         local n = r(N)
  6.         count if _mm == 3 & ((missing(`v') & !missing(p_`v')) | (!missing(`v') & missing(p_`v')))
  7.         local nmiss = r(N)
  8.         count if _mm == 3 & !missing(`v') & !missing(p_`v') & abs(`v' - p_`v') > $TOLREL * max(1, abs(`v'), abs(p_`v'))
  9.         local nval = r(N)
 10.         generate double _d = abs(`v' - p_`v') if _mm == 3 & !missing(`v') & !missing(p_`v')
 11.         summarize _d, meanonly
 12.         local mx = cond(r(N) > 0, r(max), 0)
 13.         drop _d
 14.     }
 15.     local nbad = `nmiss' + `nval'
 16.     local verdict = cond(`nbad' == 0, "PASS", "FAIL")
 17.     post pf ("B") ("`v'") (`n') (.) (`nbad') (`mx') ("`verdict'") ("one-sided missing `nmiss'; value differences `nval'")
 18.     di as text %-6s "`verdict'" " [B] `v': rows `n', one-sided missing `nmiss', value differences `nval', max abs diff `mx'"
 19. end

. 
. * cmp_str: rebuilt string variable v against panel variable p_v, rows present in both files
. capture program drop cmp_str

. program define cmp_str
  1.     version 14.1
  2.     args v
  3.     quietly {
  4.         count if _mm == 3
  5.         local n = r(N)
  6.         count if _mm == 3 & ustrtrim(`v') != ustrtrim(p_`v')
  7.         local nbad = r(N)
  8.     }
  9.     local verdict = cond(`nbad' == 0, "PASS", "FAIL")
 10.     post pf ("B") ("`v'") (`n') (.) (`nbad') (.) ("`verdict'") ("text compare, dash read as empty")
 11.     di as text %-6s "`verdict'" " [B] `v': rows `n', differences `nbad'"
 12. end

. 
